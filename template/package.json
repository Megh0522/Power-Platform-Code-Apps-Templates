    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@microsoft/power-apps-cli": "1.2.0",
    "@microsoft/power-apps-vite": "1.0.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
